# Generated by Ansible - Do not edit manually
environments:
  prod: &prod
    values:
      - {{ (bootstrap_dir + '/../clusters/_common.yaml') | realpath }}
      - {{ (bootstrap_dir + '/../clusters/prod.yaml') | realpath }}
  dev:
    values:
      - {{ (bootstrap_dir + '/../clusters/_common.yaml') | realpath }}
      - {{ (bootstrap_dir + '/../clusters/dev.yaml') | realpath }}
  default: *prod

helmDefaults:
  cleanupOnFail: true
  wait: true
  waitForJobs: true

templates:
  raw:
    chart: resources
    transformers:
      - {{ (bootstrap_dir + '/../common/transformers/common-annotations.yaml.gotmpl') | realpath }}
      - {{ (bootstrap_dir + '/../common/transformers/common-labels.yaml.gotmpl') | realpath }}

