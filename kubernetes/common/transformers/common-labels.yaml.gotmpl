apiVersion: builtin
kind: LabelTransformer
metadata:
  name: common-labels
labels:
  app.kubernetes.io/name: {{ .Release.Name }}
  app.kubernetes.io/instance: {{ .Release.Name }}
  app.kubernetes.io/part-of: {{ env "HELMFILE_PART_OF" | default ( env "PWD" | base ) }}
fieldSpecs:
  - path: metadata/labels
    create: true
