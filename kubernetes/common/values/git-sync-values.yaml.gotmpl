---
# yaml-language-server: $schema=https://raw.githubusercontent.com/bjw-s-labs/helm-charts/common-5.2.1/charts/library/common/values.schema.json
# This template assume bjw-s app-template and also assumes the config is held in /config.

controllers:
  {{ .Release.Name }}:
    initContainers:
      git-sync:
        restartPolicy: Always   # native sidecar, needs Kubernetes 1.28+
        image:
          repository: docker.io/alpine/git
          tag: 2.54.0@sha256:6a1fdb962814ca11508ca8d1bab94375b5b7ac4e4a9a40981c29fc32c02f095d
        command: ["/bin/sh", "/scripts/sync.sh"]
        env:
          GITHUB_USER: {{ required "gitSync.githubUser is required" (.Values | get "gitSync.githubUser" "") | quote }}
          REPO_NAME: {{ .Values | get (printf "gitSync.repoNames.%s" .Release.Name) (printf "%s-config" .Release.Name) | quote }}
          GIT_BRANCH: main
          SYNC_PATH: {{ .Values | get (printf "gitSync.paths.%s" .Release.Name) "/config" | quote }}
          SYNC_INTERVAL: "60"
          HOME: /tmp
        securityContext:
          runAsUser: 0   # matches config-initialization, so file ownership stays consistent
        lifecycle:
          postStart:
            exec:
              command:
                - /bin/sh
                - -c
                - |
                  i=0
                  while [ ! -f /tmp/ready ]; do
                    i=$((i + 1))
                    [ "${i}" -ge 300 ] && exit 1
                    sleep 1
                  done

persistence:
  sync-scripts:
    type: configMap
    name: "{{ .Release.Name }}-git-sync-scripts"
    defaultMode: 0755
    advancedMounts:
      {{ .Release.Name }}:
        git-sync:
          - path: /scripts

rawResources:
  git-sync-scripts:
    enabled: true
    forceRename: "{{ .Release.Name }}-git-sync-scripts"
    manifest:
      apiVersion: v1
      kind: ConfigMap
      data:
        sync.sh: |
          #!/bin/sh
          cd "${SYNC_PATH}" || exit 1
          git config --global --add safe.directory "${SYNC_PATH}"
          trap 'exit 0' TERM INT

          # Need to initialise repository?
          if [ ! -d .git ]; then
            echo "Initializing config repository from GitHub..."
            rm -rf temp-dir
            git clone --branch "${GIT_BRANCH}" \
              "https://github.com/${GITHUB_USER}/${REPO_NAME}" temp-dir || exit 1
            mv temp-dir/.git .
            rm -rf temp-dir
            git checkout . || exit 1
          fi
          touch /tmp/ready

          fails=0
          while true; do
            dirty=$(git status --porcelain --untracked-files=no -- . \
              ':(exclude)automations.yaml' \
              ':(exclude)scenes.yaml' \
              ':(exclude)scripts.yaml')
            if [ -n "${dirty}" ]; then
              echo "$(date -u +%FT%TZ) local changes present, skipping pull"
            elif git pull --ff-only -q origin "${GIT_BRANCH}"; then
              fails=0
            else
              fails=$((fails + 1))
              echo "$(date -u +%FT%TZ) pull failed (${fails} in a row)"
              [ "${fails}" -ge 5 ] && exit 1
            fi
            sleep "${SYNC_INTERVAL}" &
            wait $!
          done
