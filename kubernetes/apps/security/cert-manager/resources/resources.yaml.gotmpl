---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: {{.Values.certManager.issuerName}}
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  acme:
    server: {{.Values.certManager.acmeServer}}
    email: {{.Values.certManager.email}}
    privateKeySecretRef:
      name: {{.Values.certManager.issuerName}}
    solvers:
      - dns01:
          cloudflare:
            email: {{.Values.certManager.email}}
            apiTokenSecretRef:
              name: cloudflare-cert-manager-token
              key: tunnelToken
        selector:
          dnsZones:
            - {{.Values.cluster.domain}}


---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: cluster-tls-cert
  namespace: network
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  secretName: cluster-tls-secret
  issuerRef:
    name: {{.Values.certManager.issuerName}}
    kind: ClusterIssuer
  commonName: "*.{{.Values.cluster.domain}}"
  dnsNames:
    - {{.Values.cluster.domain}}
    - "*.{{.Values.cluster.domain}}"

  # Self signed certificates (common across environments)

---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: cluster-selfsigned-issuer
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  selfSigned: {}


---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: cluster-signed-issuer
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  ca:
    secretName: cluster-signed-issuer-secret


---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: &name cluster-signed-issuer
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  isCA: true
  commonName: *name
  subject:
    organizations:
      - {{.Values.cluster.domain}}
  secretName: cluster-signed-issuer-secret
  privateKey:
    algorithm: ECDSA
    size: 256
  issuerRef:
    name: cluster-selfsigned-issuer
    kind: ClusterIssuer
    group: cert-manager.io
