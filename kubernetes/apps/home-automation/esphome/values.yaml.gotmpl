---
# yaml-language-server: $schema=https://raw.githubusercontent.com/bjw-s-labs/helm-charts/common-5.2.1/charts/library/common/values.schema.json
# yamllint disable-line rule:line-length

controllers:
  esphome:
    pod:
      annotations:
        goldilocks.fairwinds.com/vpa-resource-policy: |
          containerPolicies:
            - containerName: app
              mode: "Off"

        reloader.stakater.com/auto: "true"
        k8s.v1.cni.cncf.io/networks: |
          [{
            "name":"home-lan",
            "namespace": "network",
            "ips": ["{{.Values.network.esphome}}"]
          }]

    containers:
      app:
        image:
          repository: ghcr.io/esphome/esphome
          # yamllint disable-line rule:line-length
          tag: 2026.11.0@sha256:6351ae811202064bb3eb49dde982609b47acd523103a66d7b9c5c1431beea055
        env:
          TZ: "Europe/London"
          ESPHOME_DASHBOARD_USE_PING: "true"
          DISABLE_HA_AUTHENTICATION: "true"
        resources:
          requests:
            cpu: 2000m
            memory: 1Gi
          limits:
            memory: 3584Mi

      code-server:
        dependsOn: app
        image:
          repository: ghcr.io/coder/code-server
          # yamllint disable-line rule:line-length
          tag: 4.145.2@sha256:09565f9e07f5624554e295e8bab0e2fec4a7c533eb3cff459ed6596a4d3d7c1c
        env:
          EXTENSIONS_GALLERY: '{ "serviceUrl": "https://marketplace.visualstudio.com/_apis/public/gallery", "itemUrl": "https://marketplace.visualstudio.com/items" }'
        args:
          - --auth=none
          - --disable-telemetry
          - --disable-update-check
          - --user-data-dir=/config/.code-server
          - --extensions-dir=/config/.code-server
          - --port=12321
          # - --install-extension=trunk.io
          # - --install-extension=github.copilot
          - /config
        securityContext:
          runAsUser: 0
        envFrom:
          - secretRef:
              name: "{{.Release.Name}}-github"
        resources:
          requests:
            cpu: 10m
            memory: 443Mi
          limits:
            # cpu: null
            memory: 3Gi

service:
  app:
    forceRename: "{{.Release.Name}}"
    ports:
      http:
        port: 6052
  code-server:
    ports:
      http:
        port: 12321

dnsConfig:
  nameservers:
    - 10.58.0.21
    - 10.58.0.22

configMaps:
  kopiaignore:
    enabled: true
    forceRename: "{{.Release.Name}}-kopiaignore"
    data:
      .kopiaignore: |
        /.esphome
        /.code-server/logs
        /.git

persistence:
  config:
    type: persistentVolumeClaim
    storageClass: longhorn
    accessMode: ReadWriteOnce
    retain: true
    size: 5Gi
    globalMounts:
      - path: /config
  build:
    enabled: true
    type: emptyDir
    globalMounts:
      - path: /config/.esphome
        readOnly: false
  secrets:
    type: secret
    name: "{{.Release.Name}}-secret"
    globalMounts:
      - path: /config/secrets.yaml
        subPath: secrets.yaml
        readOnly: true
  kopiaignore:
    type: configMap
    name:  "{{.Release.Name}}-kopiaignore"
    advancedMounts:
      esphome:
        app:
          - path: /config/.kopiaignore
            subPath: .kopiaignore
            readOnly: true
