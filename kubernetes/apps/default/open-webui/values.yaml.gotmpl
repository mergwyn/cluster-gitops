---

ollama:
  enabled: false


service:
  type: ClusterIP
  port: &port 8080

replicaCount: 1

resources:
  requests:
    cpu: 15m
    memory: 1181Mi
  limits:
    cpu: 15m
    memory: 1939Mi

websocket:
  redis:
    resources:
      requests:
        cpu: 15m
        memory: 100Mi
      limits:
        memory: 100Mi

ollamaUrls:
  - http://mike.theclarkhome.com:11434

# Optional: Add OpenRouter / OpenAI endpoints here if you want access to Claude as well
extraEnvVars:
  WEBUI_NAME: "The Clark Home AI"
  ENABLE_OPENROUTER: "true"
  MODEL_FILTER_LIST: "openrouter/free,openrouter/auto,llama3.1:8b,qwen3:8b"


# Configure persistent storage for chat histories and login accounts
persistence:
  enabled: true
  existingClaim: ""  # Leave blank to let k3s auto-provision, or swap in a Longhorn PVC name
  size: 3Gi
  accessModes:
    - ReadWriteOnce
  annotations:
    helm.sh/resource-policy: keep

route:
  enabled: true
  hostnames:
    - "{{ .Release.Name }}.{{ .Values.cluster.domain }}"
  parentRefs:
    - name: traefik-internal
      namespace: network
      sectionName: websecure

ingress:
  enabled: true
  class: "cloudflare-tunnel"
  annotations:
    cloudflare-tunnel-ingress-controller.strrl.dev/backend-protocol: http
  host: "{{ .Release.Name }}.{{ .Values.cluster.domain }}"

pipelines:
  enabled: false
  persistence:
    enabled: true
    existingClaim: "" # Leave blank to let k3s auto-provision, or swap in a Longhorn PVC name
    size: 2Gi
    accessModes:
      - ReadWriteOnce
    annotations:
      helm.sh/resource-policy: keep
