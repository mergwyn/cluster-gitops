---

ollama:
  enabled: false

ui:
  enable_signup: false
  enable_login_form: true
  enable_password_change_form: true
  enable_community_sharing: true
  enable_message_ratings: true

direct:
  enable: true

models:
  base_models_cache: true

openai:
  enable: true
  # These will be overridden by envFrom from the Secret below
  api_keys: ["placeholder"]
  api_base_urls:
    - "https://api.openai.com/v1"
    - "https://openrouter.ai/api/v1"

ollamaUrls:
  - http://mike.theclarkhome.com:11434
  -
service:
  type: ClusterIP
  port: &port 8080

replicaCount: 1

resources:
  requests:
    cpu: 15m
    memory: 1181Mi
  limits:
    cpu: 15m
    memory: 1939Mi

websocket:
  redis:
    resources:
      requests:
        cpu: 15m
        memory: 100Mi
      limits:
        memory: 100Mi

extraEnvFrom:
  - secretRef:
      name: &secret openwebui-env

annotations:
  secret.reloader.stakater.com/reload: *secret

# Optional: Add OpenRouter / OpenAI endpoints here if you want access to Claude as well
extraEnvVars:
  - name: WEBUI_NAME
    value: "Clark AI"
  - name: ENABLE_WEB_SEARCH
    value: "true"
  - name: WEB_SEARCH_ENGINE
    value: "tavily"
  - name: OPENAI_API_BASE_URL
    value: "https://openrouter.ai/api/v1"
  - name: OPENAI_USER_MODELS
    value: |
      [
        {"id": "openrouter/free", "name": "OpenRouter Free", "description": "Auto-selected free models"},
        {"id": "openrouter/auto", "name": "OpenRouter Auto", "description": "Auto-selected by cost/latency"}
      ]

# Configure persistent storage for chat histories and login accounts
persistence:
  enabled: true
  existingClaim: ""  # Leave blank to let k3s auto-provision, or swap in a Longhorn PVC name
  size: 3Gi
  accessModes:
    - ReadWriteOnce
  annotations:
    helm.sh/resource-policy: keep

route:
  enabled: true
  hostnames:
    - "{{ .Release.Name }}.{{ .Values.cluster.domain }}"
  parentRefs:
    - name: traefik-internal
      namespace: network
      sectionName: websecure

ingress:
  enabled: true
  class: "cloudflare-tunnel"
  annotations:
    cloudflare-tunnel-ingress-controller.strrl.dev/backend-protocol: http
  host: "{{ .Release.Name }}.{{ .Values.cluster.domain }}"

pipelines:
  enabled: false
  persistence:
    enabled: true
    existingClaim: "" # Leave blank to let k3s auto-provision, or swap in a Longhorn PVC name
    size: 2Gi
    accessModes:
      - ReadWriteOnce
    annotations:
      helm.sh/resource-policy: keep
