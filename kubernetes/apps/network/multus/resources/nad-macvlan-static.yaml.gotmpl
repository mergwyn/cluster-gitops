---
apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: macvlan-static
spec:
  config: |-
    {
      "cniVersion": "0.3.1",
      "name": "macvlan-static",
      "type": "ipvlan",
      "master": "{{.Values.network.device}}",
      "mode": "l2",
      "ipam": {
        "type": "host-local",
        "subnet": "{{.Values.network.subnet}}"
        "rangeStart": "{{.Values.network.macvlanStatic.rangeStart}}",
        "rangeEnd": "{{.Values.network.macvlanStatic.rangeEnd}}",
        "gateway": ""
      }
    }
