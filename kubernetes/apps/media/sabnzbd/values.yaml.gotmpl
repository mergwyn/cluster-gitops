---
# yaml-language-server: $schema=https://raw.githubusercontent.com/bjw-s-labs/helm-charts/common-5.0.1/charts/library/common/values.schema.json

controllers:
  sabnzbd:
    annotations:
      reloader.stakater.com/auto: "true"
      setGateway: "false"  # TODO remove this once the pod-gatway is disabled for the vpn NS
      k8s.v1.cni.cncf.io/networks: |
        [{
          "name": "homelan",
          "namespace": "network",
          "ips": ["{{ .Values.network.sabnzbd }}"],
        }]
    containers:
      app:
        image:
          repository: ghcr.io/home-operations/sabnzbd
          tag: 5.1.2@sha256:8172dc78c4e70baf88b18afca851bf77487e2e22802a6bd3502d7ef211dfb8fd
        env:
          SABNZBD__PORT: &port 8080
          TZ: Europe/London
        envFrom:
          - secretRef:
              name: "{{ .Release.Name }}-api-key"
        probes:
          liveness: &probes
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /api?mode=version
                port: *port
              initialDelaySeconds: 0
              periodSeconds: 10
              timeoutSeconds: 1
              failureThreshold: 3
          readiness: *probes
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities: {drop: ["ALL"]}
        resources:
          requests:
            cpu: 10m
            memory: 195Mi
          limits:
            memory: 1Gi

defaultPodOptions:
  securityContext:
    runAsNonRoot: true
    runAsUser: 3001
    runAsGroup: 513
    fsGroup: 513
    fsGroupChangePolicy: OnRootMismatch

service:
  app:
    forceRename: "{{.Release.Name}}"
    ports:
      http:
        port: *port

persistence:
  config:
    enabled: true
    forceRename: "{{ .Release.Name }}-config"
    retain: true
    storageClass: longhorn
    accessMode: ReadWriteOnce
    size: 1Gi
  data:
    enabled: true
    existingClaim:  vpn-nfs-pvc
    globalMounts:
      - path: /data
  tmp:
    type: emptyDir

route:
  app:
    hostnames:
      - "{{ .Release.Name }}.{{ .Values.cluster.domain }}"
    parentRefs:
      - name: traefik-internal
        namespace: network
        sectionName: websecure
    rules:
      - backendRefs:
          - identifier: app
            port: *port

ingress:
  external:
    enabled: true
    className: cloudflare-tunnel
    annotations:
      cloudflare-tunnel-ingress-controller.strrl.dev/backend-protocol: http
    hosts:
      - host: "{{ .Release.Name }}.{{ .Values.cluster.domain }}"
        paths:
          - path: /
            pathType: Prefix
            service:
              identifier: app
              port: *port
