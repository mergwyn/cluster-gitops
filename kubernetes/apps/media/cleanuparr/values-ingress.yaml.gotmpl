---
route:
  cleanuparr:
    forceRename: cleanuparr
    hostnames:
      - "cleanuparr.{{ .Values.cluster.domain }}"
    parentRefs:
      - name: traefik-internal
        namespace: network
        sectionName: websecure
    rules:
      - matches:
          - path:
              type: PathPrefix
              value: /
        backendRefs:
          - name: cleanuparr
            port: 11011
