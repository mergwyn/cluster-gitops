---
# yaml-language-server: $schema=https://raw.githubusercontent.com/bjw-s-labs/helm-charts/common-5.3.0/charts/library/common/values.schema.json

controllers:
  plex:
    annotations:
      reloader.stakater.com/auto: "true"
    pod:
      dnsConfig:
        options:
          - name: ndots
            value: "1"

    initContainers:
      kopiaignore:
        image:
          repository: docker.io/library/alpine
          tag: 3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
        command: ["/bin/sh", "-c"]
        # TODO better handling for database backup
        args:
          - |-
            tee /config/.kopiaignore <<!
            Plex Media Server/Cache
            Plex Media Server/Logs
            Plex Media Server/Media
            Plex Media Server/Metadata
            !
        securityContext:
          runAsUser: 0

    containers:
      app:
        image:
          repository: plexinc/pms-docker
          tag: "1.43.5.11079-b3b13e506@sha256:6d778d41daae68f89115aa87a44ae14a96b23e71a2093da173b5a9aac4091336"
        env:
          TZ: Europe/London
          ALLOWED_NETWORKS: "10.0.0.0/8"
          # PLEX_CLAIM: "claim-16YinLw_z6A2xEsM7pwD"
          PLEX_MEDIA_SERVER_APPLICATION_SUPPORT_DIR: "/config"
          PLEX_PASS: "yes"
          PLEX_UID: "3001"
          PLEX_GID: "513"
          UMASK: "002"

        probes:
          liveness: &probes
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /identity
                port: &port 32400
              initialDelaySeconds: 0
              periodSeconds: 10
              timeoutSeconds: 1
              failureThreshold: 3
          readiness: *probes
          startup:
            enabled: true
            spec:
              failureThreshold: 30
              periodSeconds: 10

        resources:
          requests:
            cpu: 763m
            memory: 1752Mi
            gpu.intel.com/i915: "1"
          limits:
            memory: 6Gi
            gpu.intel.com/i915: "1"

service:
  app:
    externalTrafficPolicy: Local
    type: LoadBalancer
    annotations:
      metallb.io/loadBalancerIPs: {{.Values.network.plex | quote}}
    loadBalancerClass: metallb.io/internal
    ports:
      http:
        port: *port

persistence:
  config:
    enabled: true
    #forceRename: "{{ .Release.Name }}-config"
    retain: true
    storageClass: longhorn
    accessMode: ReadWriteOnce
    size: 10Gi
    globalMounts:
      - path: /config
  data:
    enabled: true
    existingClaim: media-nfs-pvc
    globalMounts:
      - path: /data
  tmp:
    type: emptyDir
