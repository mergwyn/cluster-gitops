{
  "packageRules": [
    {
      "description": "Needed as there are old releases that breaks the tag discovery",
      "allowedVersions": "!(14.3.9|20.04.1)",
      "matchPackageNames": [
        "/^(gh|ls)cr.io\\/linuxserver\\/qbittorrent//"
      ]
    },
    {
      "description": "Use regex versioning for predbat_addon due to alpine- prefix in tags",
      "matchPackageNames": [
	"nipar44/predbat_addon"
      ],
      "versioning": "regex:^alpine-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Use regex versioning for Plex; tags carry a changing build hash suffix",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["plexinc/pms-docker"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[a-f0-9]+$"
    }
  ]
}
