  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)kubernetes/bootstrap/helmfile\\.d/00-prereq\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*- https://github\\.com/kubernetes-sigs/gateway-api/releases/download/(?<currentValue>v[^/]+)/standard-install\\.yaml"
      ]
    }
  ]
}
